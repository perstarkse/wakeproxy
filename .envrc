#!/usr/bin/env bash

if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

export DIRENV_LOG_FORMAT=-
export DIRENV_WARN_TIMEOUT=0s

# Enter-shell tasks install git hooks on first load; skip the noisy rerun afterward.
[[ -x .git/hooks/pre-commit ]] && export DEVENV_SKIP_TASKS=1

watch_file flake.nix
watch_file flake.lock

if use flake . --impure; then
  echo "wakeproxy: dev shell loaded" >&2
else
  echo "dev shell failed to load; fix flake.nix and run: direnv reload" >&2
  exit 1
fi
