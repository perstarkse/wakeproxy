[Unit]
Description=wakeproxy
Documentation=https://github.com/perstarkse/wakeproxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wakeproxy
Group=wakeproxy
WorkingDirectory=/var/lib/wakeproxy
EnvironmentFile=/etc/wakeproxy/wakeproxy.env
ExecStart=/usr/local/bin/wakeproxy
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/wakeproxy

[Install]
WantedBy=multi-user.target
