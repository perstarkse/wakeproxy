# Copy to .env and replace all placeholder values.

WOL_PROXY_UPSTREAM_HOST=127.0.0.1
WOL_PROXY_UPSTREAM_PORT=3000
WOL_PROXY_HEALTH_PATH=/health

WOL_PROXY_WOL_MAC=aa:bb:cc:dd:ee:ff
WOL_PROXY_WOL_BROADCAST_IP=127.255.255.255
WOL_PROXY_WOL_BROADCAST_PORT=9

WOL_PROXY_WAKE_TIMEOUT=180
WOL_PROXY_POLL_INTERVAL=2
WOL_PROXY_WAKE_POLL_INTERVAL_MS=2000
WOL_PROXY_READY_CACHE_TTL=5

WOL_PROXY_BIND_ADDR=127.0.0.1:8080

# Generate with:
# cargo run --quiet --example password-hash -- "your-password"
WOL_PROXY_PASSWORD_HASH=replace-with-argon2-hash

# Generate with:
# openssl rand -base64 32 | tr -d '\n'
WOL_PROXY_SESSION_SECRET=replace-with-random-secret

WOL_PROXY_SESSION_TTL_SECS=43200
WOL_PROXY_COOKIE_SECURE=true

WOL_PROXY_LOGIN_MAX_FAILURES=5
WOL_PROXY_LOGIN_LOCKOUT_SECS=60
WOL_PROXY_LOGIN_WINDOW_SECS=300
WOL_PROXY_LOGIN_MAX_TRACKED_IPS=10000

WOL_PROXY_TRUST_PROXY_HEADERS=false
# Comma-separated list when proxy header trust is enabled.
WOL_PROXY_TRUSTED_PROXY_IPS=
