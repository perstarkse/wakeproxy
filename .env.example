# Copy to .env and replace all placeholder values.

WAKEPROXY_UPSTREAM_HOST=127.0.0.1
WAKEPROXY_UPSTREAM_PORT=3000
WAKEPROXY_HEALTH_PATH=/health

WAKEPROXY_WOL_MAC=aa:bb:cc:dd:ee:ff
WAKEPROXY_WOL_BROADCAST_IP=127.255.255.255
WAKEPROXY_WOL_BROADCAST_PORT=9

WAKEPROXY_WAKE_TIMEOUT=180
WAKEPROXY_POLL_INTERVAL=2
WAKEPROXY_WAKE_POLL_INTERVAL_MS=2000
WAKEPROXY_READY_CACHE_TTL=5
WAKEPROXY_KEEP_AWAKE_COMMAND=
WAKEPROXY_KEEP_AWAKE_MAX_SECS=14400

WAKEPROXY_BIND_ADDR=127.0.0.1:8080

# Generate with:
# cargo run --quiet --example password-hash -- "your-password"
WAKEPROXY_PASSWORD_HASH=replace-with-argon2-hash

# Generate with:
# openssl rand -base64 32 | tr -d '\n'
WAKEPROXY_SESSION_SECRET=replace-with-random-secret

WAKEPROXY_SESSION_TTL_SECS=43200
WAKEPROXY_COOKIE_SECURE=true

WAKEPROXY_LOGIN_MAX_FAILURES=5
WAKEPROXY_LOGIN_LOCKOUT_SECS=60
WAKEPROXY_LOGIN_WINDOW_SECS=300
WAKEPROXY_LOGIN_MAX_TRACKED_IPS=10000

WAKEPROXY_TRUST_PROXY_HEADERS=false
# Comma-separated list when proxy header trust is enabled.
WAKEPROXY_TRUSTED_PROXY_IPS=
